        },
        "view_sql": "SELECT * FROM business.vw_repeat_customer_percentage",
        "raw_sql": "WITH customers AS (\n SELECT customer_id,COUNT(*) AS paid_orders FROM business.ticket_orders WHERE status='Paid' GROUP BY customer_id)\n SELECT COUNT(*) AS purchasing_customers,COUNT(*) FILTER(WHERE paid_orders>1) AS repeat_customers,\n 100.0*COUNT(*) FILTER(WHERE paid_orders>1)/NULLIF(COUNT(*),0) AS repeat_customer_pct FROM customers",
        "interpretation": "Views centralize the definition. Ordinary views are not precomputed and do not inherently speed up queries."
